{
  "openapi": "3.1.1",
  "info": {
    "title": "Scholarship.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5080/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Scholarship.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/opportunities": {
      "get": {
        "tags": [
          "Scholarship.Api"
        ],
        "operationId": "ListOpportunities",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OpportunityResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OpportunityResponse": {
        "required": [
          "id",
          "title",
          "institutionName",
          "intakeLabel",
          "isFictional"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "institutionName": {
            "type": "string"
          },
          "intakeLabel": {
            "type": "string"
          },
          "isFictional": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Scholarship.Api"
    }
  ]
}
